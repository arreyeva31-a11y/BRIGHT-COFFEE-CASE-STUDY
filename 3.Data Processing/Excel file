  .tag { display: inline-block; background: #4a2c17; color: #fff; border-radius: 12px; padding: 3px 12px; font-size: 0.78em; margin: 2px 4px; }
  footer { text-align: center; color: #a08070; font-size: 0.85em; margin-top: 20px; padding: 15px; }
